<Project Sdk="Microsoft.NET.Sdk">

  <!-- PokeUDS's PKHeX helper: JSON requests on stdin, one reply per line on stdout (docs/pkhex.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pokeuds-pkhex</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" Version="26.10.18" />
  </ItemGroup>

</Project>
